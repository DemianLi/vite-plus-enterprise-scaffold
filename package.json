{
  "name": "@org/monorepo",
  "version": "1.16.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp run console#dev",
    "bff": "BFF_MOCK_ROUTES=apps/console/bff-routes.ts node platform/bff-mock/src/cli.ts",
    "check": "vp check",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "conformance": "node tools/conformance/src/cli.ts",
    "bff-check": "vp run -F @org/bff-check test",
    "gate": "node tools/gate-roster/src/cli.ts && node tools/conformance/src/cli.ts && node tools/api-surface/src/cli.ts && node tools/vue-typecheck/src/cli.ts && node tools/theme-verify/src/cli.ts && node tools/exit-drill/src/cli.ts && node tools/supply-chain/src/cli.ts && node tools/compliance/src/cli.ts && node tools/pii-check/src/cli.ts && node tools/doc-facts/src/cli.ts && node tools/scope-check/src/cli.ts && node tools/threshold-check/src/cli.ts && node tools/promise-check/src/cli.ts && eslint . --max-warnings=0 && eslint --config platform/eslint-config/src/a11y.js . --max-warnings=0",
    "exit-drill": "node tools/exit-drill/src/cli.ts --full",
    "ready": "vp check && vp run -r test -- --reporter=default --reporter=json --outputFile=.vitest-results.json && vp run -r build && vpr gate && node tools/spec-report/src/cli.ts --check",
    "api-surface": "node tools/api-surface/src/cli.ts",
    "supply-chain": "node tools/supply-chain/src/cli.ts",
    "capture-health": "node tools/supply-chain/src/cli.ts --capture-health",
    "sca-dossier": "node tools/supply-chain/src/cli.ts --dossier",
    "mirror-manifest": "node tools/supply-chain/src/cli.ts --manifest",
    "airgap": "node tools/supply-chain/src/cli.ts --airgap",
    "csp-verify": "node tools/csp-verify/src/cli.ts",
    "csp-probe": "node tools/csp-verify/src/cli.ts --print-probe",
    "theme-verify": "node tools/theme-verify/src/cli.ts",
    "compliance": "node tools/compliance/src/cli.ts",
    "compliance-update": "node tools/compliance/src/cli.ts --update",
    "evidence": "node tools/compliance/src/cli.ts --evidence",
    "pii": "node tools/pii-check/src/cli.ts",
    "doc-facts": "node tools/doc-facts/src/cli.ts",
    "a11y": "eslint --config platform/eslint-config/src/a11y.js . --max-warnings=0",
    "gate-roster": "node tools/gate-roster/src/cli.ts",
    "vue-typecheck": "node tools/vue-typecheck/src/cli.ts",
    "exit-surface": "node tools/exit-drill/src/cli.ts",
    "scope-check": "node tools/scope-check/src/cli.ts",
    "threshold-check": "node tools/threshold-check/src/cli.ts",
    "promise-check": "node tools/promise-check/src/cli.ts",
    "spec-report": "node tools/spec-report/src/cli.ts"
  },
  "devDependencies": {
    "@org/eslint-config": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.21.0"
}
